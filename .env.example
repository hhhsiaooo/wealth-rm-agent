# Copy this file to .env and fill in your own key(s).

# Anthropic (paid, usage-based billing): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini (free tier available, no credit card required for Flash models
# within rate limits): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model names live here, not in the code. Free-tier quotas are per model, so change
# GEMINI_MODEL when one model's quota is used up. (Code falls back to the same defaults
# if these lines are missing.)
GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_MODEL=claude-sonnet-5
# EMBEDDING_MODEL=gemini-embedding-001
